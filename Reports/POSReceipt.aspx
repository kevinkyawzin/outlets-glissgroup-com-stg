<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="POSReceipt.aspx.cs" Inherits="BigMac.Reports.POSReceipt" %>

<%@ Register Assembly="Stimulsoft.Report.Web, Version=2008.1.206.0, Culture=neutral, PublicKeyToken=ebe6666cba19647a"
    Namespace="Stimulsoft.Report.Web" TagPrefix="cc3" %>

<%@ Register Assembly="Stimulsoft.Report.Web" Namespace="Stimulsoft.Report.Web" TagPrefix="cc2" %>
<%@ Register Assembly="Stimulsoft.Report.Web" Namespace="Stimulsoft.Report.Web" TagPrefix="cc1" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html xmlns="http://www.w3.org/1999/xhtml" >
<head runat="server">
    <title>Untitled Page</title>
</head>
<body>
    <form id="form1" runat="server">
    <div style="height: 458px">
        <cc1:stireportweb id="rwModuleHC" runat="server" reportdatasources="sdsModuleHC;sdsModuleHCP;"
          reportsource=""></cc1:stireportweb>
       
         <asp:SqlDataSource ID="sdsModuleHC" runat="server" ConnectionString="<%$ ConnectionStrings:BigMacEntities %>"
            
            SelectCommand="SELECT @cdesc cdesc, @bdesc bdesc,@cname cname,@caddress caddress,@ctel ctel,@cfax cfax,@cemail cemail,@coreg coreg,@gstreg gstreg,@discdesc discdesc, (SELECT 
                        GROUP_CONCAT(CONCAT(productdesc,'--',FLOOR(credit))  SEPARATOR '\n')
                        FROM cussup_m_cusredemption
                        WHERE refno = Invoice_m_Invoice.resourcecode AND resource = 'PACKAGEREDEEM'
                        GROUP BY refno) AS packagedetails,Invoice_m_Invoice_Items.id ItemID, Invoice_m_Invoice.status, 
                        IFNULL(Invoice_m_Invoice.printcount,0) printcount,Invoice_m_Invoice.signaturefile,CusSup_m_CusSup.cussupname, CusSup_m_CusSup.inhousecode, 
                        CusSup_m_CusSup.address, CusSup_m_CusSup.postalcode, Invoice_m_Invoice.resourcecode, Invoice_m_Invoice.createdate, Invoice_m_Invoice.createid, 
                        Invoice_m_Invoice.refno, Invoice_m_Invoice_Items.productcode, Invoice_m_Invoice_Items.productdesc, Invoice_m_Invoice_Items.qty, Invoice_m_Invoice_Items.uom, 
                        Invoice_m_Invoice.id AS invoiceid, IFNULL(unitprice,0) unitprice, IFNULL(lineamount,0) lineamount, IFNULL(Invoice_m_Invoice.total_subtotal,0) total_subtotal, 
                        IFNULL(Invoice_m_Invoice.total_salestax,0) total_salestax, IFNULL(Invoice_m_Invoice.total_discount,0) total_discount, IFNULL(Invoice_m_Invoice.total_total,0) total_total, 
                        IFNULL(staff.name,'') AS lstaffid, getMemberClosingBalance(Invoice_m_Invoice.cussupid,'C$') AS cbc,getMemberClosingBalance(Invoice_m_Invoice.cussupid,'B$') AS cbb, 
                        so.total_amountreceived, (so.total_total - so.total_amountreceived) AS Balance
                        FROM Invoice_m_Invoice 
                        INNER JOIN Invoice_m_Invoice_Items ON Invoice_m_Invoice.id = Invoice_m_Invoice_Items.invoiceid 
                        INNER JOIN CusSup_m_CusSup ON Invoice_m_Invoice.cussupid = CusSup_m_CusSup.id
                        INNER JOIN salesorder_m_salesorder so ON  Invoice_m_Invoice.salesorderid = so.id
                        LEFT OUTER  JOIN Common_m_Staff staff ON  Invoice_m_Invoice.staffid = staff.id  WHERE (Invoice_m_Invoice.id = @id);"  
            
            
            
            ProviderName="<%$ ConnectionStrings:BigMacEntities.ProviderName %>">
           <SelectParameters>
                <asp:QueryStringParameter Name="id" QueryStringField="id" 
                    DefaultValue="3" />
                <asp:QueryStringParameter Name="cdesc" QueryStringField="cdesc" 
                    DefaultValue="C$" />
                <asp:QueryStringParameter Name="bdesc" QueryStringField="bdesc"
                    DefaultValue="B$" />
               <asp:QueryStringParameter Name="cname" QueryStringField="cname"
                    DefaultValue="Citi" />
               <asp:QueryStringParameter Name="caddress" QueryStringField="caddress"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="ctel" QueryStringField="ctel"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="cfax" QueryStringField="cfax"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="cemail" QueryStringField="cemail"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="coreg" QueryStringField="coreg"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="gstreg" QueryStringField="gstreg"
                    DefaultValue="" />
               <asp:QueryStringParameter Name="discdesc" QueryStringField="discdesc"
                    DefaultValue="Discount" />
            </SelectParameters>
        </asp:SqlDataSource>

        <asp:SqlDataSource ID="sdsModuleHCP" runat="server" ConnectionString="<%$ ConnectionStrings:BigMacEntities %>"
            
          SelectCommand="SELECT i.salesorderid, p.invoiceid, p.resourcecode, p.createdate, p.paymentmode, p.amountrecd FROM invoice_m_payment p
                            INNER JOIN invoice_m_invoice i ON i.id = p.invoiceid
                            WHERE i.salesorderid = (SELECT salesorderid FROM Invoice_m_Invoice WHERE id = @id)"
            ProviderName="<%$ ConnectionStrings:BigMacEntities.ProviderName %>">
           <SelectParameters>
                <asp:QueryStringParameter Name="id" QueryStringField="id" 
                    DefaultValue="4" />
            </SelectParameters>
            </asp:SqlDataSource>

        <cc3:stiwebviewer id="wvModuleHC" runat="server"></cc3:stiwebviewer>
    
    </div>
    </form>
</body>
</html>

